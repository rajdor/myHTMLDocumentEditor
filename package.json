{
  "name": "fine-line",
  "version": "1.0.0",
  "private": true,
  "description": "Fine Line: an offline, single-file WYSIWYG HTML document editor in the Fine Line Blueprint style with the diagram editor built in, and the same editor as a notebook over a folder of pages. One source, two built files.",
  "scripts": {
    "build": "node build.js",
    "build:codemirror": "node build-codemirror.js",
    "test": "node test/run-all.mjs",
    "test:editor": "node test/run-all.mjs --product=editor",
    "test:notebook": "node test/run-all.mjs --product=notebook"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/lang-xml": "6.1.0",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource/architects-daughter": "5.3.0",
    "@lezer/highlight": "1.2.5",
    "codemirror": "6.0.2",
    "marked": "18.2.1",
    "turndown": "7.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@phosphor-icons/core": "^2.1.1",
    "@sparticuz/chromium": "^138.0.0",
    "axe-core": "^4.14.1",
    "esbuild": "0.28.2",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "micromark": "^4.0.3",
    "micromark-extension-gfm": "^3.0.0",
    "puppeteer-core": "^25.16.0",
    "vnu-jar": "^26.11.20"
  },
  "engines": {
    "node": ">=22.12"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
